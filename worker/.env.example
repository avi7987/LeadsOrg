# ==========================================================
#  העתיקי קובץ זה ל-.env ומלאי את הערכים מ-Supabase
#  (Supabase → Project Settings → API)
# ==========================================================

# כתובת הפרויקט ב-Supabase, למשל https://abcdxyz.supabase.co
SUPABASE_URL=

# מפתח ה-service_role (סודי! נותן גישה מלאה — לעולם לא בצד הדפדפן)
SUPABASE_SERVICE_ROLE_KEY=

# תיקייה לשמירת החיבור לוואטסאפ (כדי לא לסרוק QR בכל הפעלה)
WA_SESSION_PATH=./.wwebjs_auth

# מצב בדיקה: true = מזהה ויוצר לידים אבל לא שולח הודעות אמת ללקוחות.
# כשמוכנים לעבוד חי — שנו ל-false
DRY_RUN=true
